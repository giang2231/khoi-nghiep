# Sao chép nội dung này vào Streamlit Cloud: App settings > Secrets
# TUYỆT ĐỐI không đưa file secrets.toml thật lên GitHub.
GEMINI_API_KEY = "dán-api-key-của-bạn-vào-đây"
# Tùy chọn:
# GEMINI_MODEL = "gemini-2.5-flash"
# DAILY_LIMIT = 100   # tổng số lượt phân tích tối đa mỗi ngày cho toàn website
# SESSION_LIMIT = 3   # số lượt tối đa cho mỗi người dùng/phiên
